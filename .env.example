# ==============================================================
# Telegram MTProto Credentials (https://my.telegram.org)
# ==============================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Generate using: python tools/generate_string_session.py
TELEGRAM_STRING_SESSION=1BVtsOHQBu4Q3...your_string_session_here...

# Telegram Target Chat ID to read from (Supergroup ID usually starts with -100)
TELEGRAM_CHAT_ID=-1001234567890

# Where to send the summary card: "me" (Saved Messages) or a Chat ID
TELEGRAM_SEND_TO=me

# ==============================================================
# Google Gemini API (https://aistudio.google.com)
# ==============================================================
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here...

# ==============================================================
